# ──────────────────────────────────────────────────────────────
# Personal AI Doctor — Environment Variables
# ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to GitHub.
# ──────────────────────────────────────────────────────────────

# ── Server ─────────────────────────────────────────────────────
# On Render, PORT is set automatically. Do not set it manually.
PORT=8000
HOST=0.0.0.0

# ── Ollama (Primary AI Provider) ───────────────────────────────
# Local development:
#   OLLAMA_BASE_URL=http://localhost:11434
#
# Production on Render (ngrok tunnel to your PC):
#   OLLAMA_BASE_URL=https://xxxx-xx-xx-xx-xx.ngrok-free.app
#
# Production on Render (self-hosted VPS):
#   OLLAMA_BASE_URL=http://YOUR_VPS_IP:11434
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=gemma4:e2b

# ── Optional Cloud AI Fallbacks ────────────────────────────────
# If GEMINI_API_KEY is set, Gemini is used INSTEAD of Ollama.
# If OPENAI_API_KEY is set, OpenAI is used INSTEAD of Ollama.
# Leave blank to use Ollama only.
GEMINI_API_KEY=
OPENAI_API_KEY=
