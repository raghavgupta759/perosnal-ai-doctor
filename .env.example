# ──────────────────────────────────────────────────────────────
# Personal AI Doctor — Environment Variables
# ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to GitHub.
# ──────────────────────────────────────────────────────────────

# ── Server ─────────────────────────────────────────────────────
# On Render, PORT is set automatically. Do not set it manually.
PORT=8000
HOST=0.0.0.0

# ── Google Gemini AI (PRIMARY PROVIDER — REQUIRED) ─────────────
# Get a free API key at: https://aistudio.google.com/apikey
# For local development, paste your key here in .env.
# For Render production, set this in the Render dashboard.
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use. Recommended: gemini-2.0-flash (fast + capable)
# Other options: gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash-lite
GEMINI_MODEL=gemini-2.0-flash
